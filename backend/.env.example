# Runtime mode: dev | prod. Selects DB/seed/concurrency defaults.
# Mode-conditional defaults live in app/config.py; override individual
# settings below only when you need to deviate from the mode default.
# REQUIRED, with NO default: the API
# server, the worker and alembic refuse to start without it (ForgeEnvNotSetError;
# a blank value counts as unset). It used to default to dev, so an install that
# merely forgot it started as dev -- dev users seeded, the identity list served
# unauthenticated, the X-Forge-User-Id header trusted from anyone. `dev.ps1`
# supplies dev for the processes it starts when neither the environment nor
# this file sets it, and says so; a real install sets FORGE_ENV=prod here.
FORGE_ENV=dev

# dev: optional, defaults to the local SQLite file if unset or blank.
# prod: REQUIRED — startup aborts if unset or blank (a cleared value is
# treated as never having been set, never falls back to SQLite), and also
# aborts if set to a sqlite: URL (prod never runs on SQLite, however
# "not set" is spelled — ProdDatabaseUrlMissingError covers all three).
# DATABASE_URL=sqlite:///./forge_dev.db

# Comma-separated list of origins trusted for TWO things at once (ADR
# 0028 §Decision layer 3): browser CORS (for a cross-origin
# VITE_API_BASE_URL frontend), and — as of ADR 0028 — the platform's own
# cross-site/same-site write check, which exempts a request only when its
# Origin is an EXACT member of this list. An operator adding a host here
# therefore grants it BOTH: reading the API's responses, and writing to it
# with the caller's cookie. NEVER add a generated service's own host here
# — that would hand every deployed service's origin write access to the
# platform on the viewer's behalf, exactly what ADR 0028 exists to
# prevent. `null` and `*` are never exemptions for the write check no
# matter what you put here (a sandboxed document's own requests carry
# Origin: null; `*` would switch the write check off).
# VALIDATED AT STARTUP (ADR 0028 §Amendment 2026-10-17): the server, the
# worker and alembic refuse to start (CorsOriginsError) when an entry is `*`,
# `null`, not a bare `scheme://host[:port]` (http or https, no path, no
# trailing slash, no credentials), or has a host that is APPS_BASE_DOMAIN or a
# subdomain of it -- that is where generated services live. Without `*` refused,
# Starlette would answer it (credentials on) by echoing any origin asking, and
# a generated service on the same site could read the API as the visitor.
CORS_ORIGINS=http://localhost:5173

# directory of the built SPA (`npx vite build` in frontend/ writes
# frontend/dist). When set, the API process serves it on its own origin: real files as
# files, every other non-/api GET as index.html. Unset (default) serves no files. A relative
# path resolves from the working directory (backend/). In prod a missing directory or one
# without index.html refuses to start; in dev it only logs a warning.
# FRONTEND_DIST_DIR=../frontend/dist

# global concurrent-build cap for the worker process.
# Default if unset: dev=1, prod=2.
# BUILD_CONCURRENCY=1

# max build wall-clock
# duration (minutes) before the worker sweep fails a stale RUNNING build
# with reason TIMEOUT. Default if unset: dev=20, prod=30.
# BUILD_MAX_DURATION_MINUTES=20

# How often (seconds) the worker polls for QUEUED builds / sweeps timeouts.
# WORKER_POLL_INTERVAL_SECONDS=2.0

# pinned builder image every L3 sandbox container is
# created from. Pin a tag/digest explicitly; never rely on floating :latest.
# SANDBOX_IMAGE=python:3.11-slim

# (ADR 0003 invariant 4).
# Default if unset: dev=2048, prod=4096.
# SANDBOX_MEMORY_LIMIT_MB=2048
# Default if unset: dev=1.0, prod=2.0.
# SANDBOX_CPU_LIMIT_CORES=1.0
# Max concurrent processes inside one sandbox container.
# SANDBOX_PIDS_LIMIT=256
# every deploy and preview container is created with a capped
# `json-file` log config, so a chatty service cannot fill the host whatever the
# daemon's own `daemon.json` says. Each container keeps at most
# CONTAINER_LOG_MAX_FILES files of CONTAINER_LOG_MAX_SIZE each (digits and an
# optional k, m or g). Defaults: 10m and 3, at most 30 MB of log per container.
# CONTAINER_LOG_MAX_SIZE=10m
# CONTAINER_LOG_MAX_FILES=3
# the build sandbox's disk cap, enforced by a watchdog that polls the
# container's writable-layer size (`SizeRw`) and kills the build over the cap,
# and by a harvest that stops reading at the same number of bytes. The engine's
# `storage_opt` is NOT used: it is accepted-but-ignored on some hosts (Docker
# Desktop) and refused on others, so it cannot be the cap. A burst between two
# polls is possible; the poll interval bounds it.
# Default if unset: dev=2048, prod=5120.
# SANDBOX_DISK_LIMIT_MB=2048
# SANDBOX_DISK_POLL_INTERVAL_SECONDS=1.0

# Size cap (bytes) on harvested execution logs.
# SANDBOX_LOG_MAX_BYTES=1000000

# Prefix for the isolated, default-deny Docker network created fresh per
# sandbox run and destroyed with the container (ADR 0003 invariant 3).
# SANDBOX_NETWORK_NAME=forge-sandbox-net

# ADR 0003 §Residual risk: container runtime for the L3 BUILD
# container (the Docker `--runtime=` argument), so a stronger runtime such as
# gVisor can be measured by configuration instead of a code change. Leave
# UNSET to keep today's behaviour: unset means no runtime argument is passed
# at all, which is not the same as "runc" on a host with a different
# default-runtime.
#   BUILD_CONTAINER_RUNTIME=runsc   # requires gVisor installed AND registered
#                                   # in the daemon's `runtimes` config; the
#                                   # engine rejects an unknown runtime name.
# Scope: the build container and, unless PREVIEW_CONTAINER_RUNTIME says
# otherwise, the L3 preview container (ADR 0046). L4 service containers
# deliberately ignore it — they share only the SANDBOX_* resource caps above.
# In prod the worker refuses to start when a configured runtime is not
# registered with the Docker engine (a named error); in dev it logs a warning.
# Compatibility with runsc is UNMEASURED (gVisor is not available
# on Docker Desktop/Windows); treat turning this on as an experiment.
# BUILD_CONTAINER_RUNTIME=

# ADR 0046 §Decision 2: container runtime for the L3 PREVIEW
# container. Unset means "the same as BUILD_CONTAINER_RUNTIME", and when that
# is unset too no runtime argument is passed at all. Set, it applies to
# previews only, never to a build. L4 service containers never use it.
# PREVIEW_CONTAINER_RUNTIME=

# ADR 0014: LLM egress proxy. The REAL Anthropic API key. Lives only
# in this file (or the process env it's loaded from) — never written to a
# sandbox container's environment, never logged. Unset in dev by default;
# the sandbox-backed agent executor only activates when this AND
# USE_SANDBOX_EXECUTOR=true are set (otherwise the placeholder executor
# stays in use).
# ANTHROPIC_API_KEY=

# Upstream Anthropic API base URL the proxy forwards to. Override only for
# testing against a stub upstream.
# ANTHROPIC_UPSTREAM_BASE_URL=https://api.anthropic.com

# ADR 0035: the REAL OpenAI API key, for the second agent engine. Same rules as
# ANTHROPIC_API_KEY: it lives only in this file (or the process env it is loaded
# from), is injected only into the OpenAI-dialect LLM proxy container, is never
# written to a sandbox container's environment, never logged and never shown in
# the admin console. Setting it alone selects nothing.
# OPENAI_API_KEY=

# Upstream OpenAI API base URL the OpenAI-dialect proxy forwards to. Override only
# for testing against a stub upstream.
# OPENAI_UPSTREAM_BASE_URL=https://api.openai.com

# ADR 0035: the model the OpenAI engine runs (sent to the runner and recorded on the
# build). It should have a row in the proxy's price table (services/llm_proxy_openai.py);
# an unlisted model is charged at the most expensive row.
# OPENAI_MODEL=gpt-5-mini

# ADR 0035: pinned image for OpenAI-engine builds (the OpenAI Agents SDK preinstalled),
# built from backend/docker/agent-sandbox-openai/Dockerfile.
# OPENAI_AGENT_SANDBOX_IMAGE=forge-agent-sandbox-openai:latest

# ADR 0035 §Decision 5: which engine builds run on, `anthropic` or `openai`. Unset means
# the only engine whose key is configured, or `anthropic` when both are. An engine whose
# key is not configured is unavailable: a build that resolves to it FAILS, it never falls
# back to the other one. (A later task moves this choice into the database, set by an admin.)
# AGENT_ENGINE_DEFAULT=

# Host/port the LLM egress proxy binds to inside L2 (ADR 0014).
# LLM_PROXY_HOST=127.0.0.1
# LLM_PROXY_PORT=8801

# per-build LLM token/cost budget
# enforced by the proxy. Exceeding either fails the build with
# BUDGET_EXCEEDED. Operator-overridable initial defaults.
# BUILD_TOKEN_BUDGET=200000
# BUILD_COST_BUDGET_USD=5.0

# ADR 0047: when a build's preview smoke check
# measures a route that answers 500 or above (or does not answer), the build may run this many
# repair attempts inside the same build, on the same proxy token and the same budget and
# wall-clock (a repair starts only if the largest cost and the longest duration of any earlier
# attempt still fit in what is left). The last attempt that completed ships. 0 turns the loop off.
# Allowed range 0 to 3; anything else refuses to start.
# BUILD_REPAIR_MAX_ATTEMPTS=1

# An eval run is a manual, admin-started run of
# real builds over a fixed request set, and it spends real money through the LLM proxy.
# EVAL_RUN_BUDGET_USD caps one whole run (recorded on the run when it starts); each case's
# build gets min(BUILD_COST_BUDGET_USD, what is left of it). When what is left drops below
# EVAL_CASE_MIN_BUDGET_USD the remaining cases are not started (NOT_RUN_BUDGET) and the run
# ends STOPPED_BUDGET. A run can overshoot by at most one proxy call. Restart to change.
# EVAL_RUN_BUDGET_USD=1.0
# EVAL_CASE_MIN_BUDGET_USD=0.05

# pinned image for agent-run sandboxes (agent runtime
# preinstalled), built from backend/docker/agent-sandbox/Dockerfile.
# AGENT_SANDBOX_IMAGE=forge-agent-sandbox:latest

# explicit opt-in to the sandbox-backed BuildExecutor. Never implied
# by a key alone: this AND at least one engine's key (ANTHROPIC_API_KEY or
# OPENAI_API_KEY, ADR 0035) must be set.
# USE_SANDBOX_EXECUTOR=false

# git-host provider. "github" is the default;
# "local" keeps one bare repository per project on this host under
# LOCAL_GIT_ROOT (nothing leaves the machine; no GITHUB_* settings needed).
# Swapping hosts = one provider module + this setting, nothing else moves.
# GIT_PROVIDER=github

# root directory of the local provider's repositories. A relative
# path is inside the backend directory. It holds every service's source, so
# back it up like the platform database. Gitignored.
# LOCAL_GIT_ROOT=local-git

# GitHub provider (app/services/github_provider.py). Token is repo-scoped,
# lives only here — never logged, never enters any sandbox container.
# GITHUB_TOKEN=
# GITHUB_ORG=
# https://api.github.com for github.com; https://<host>/api/v3 for GitHub
# Enterprise Server.
# GITHUB_BASE_URL=https://api.github.com

# template-owned files the agent may
# not change; restored from the pinned template on every build, reported as
# drift when the agent changed them relative to its own input. Comma separated;
# an entry ending in "/" is a prefix (every file under it), any other is one file.
# PROTECTED_PATHS=Dockerfile,compose.yaml

# ADR 0009 §Amendment 2026-10-05: schema paths of the template. On a MODIFY-type
# build, adding, editing or deleting any file under them refuses the build
# (AGENT_ERROR); create-type builds may add forward-only migrations. Same entry
# syntax as PROTECTED_PATHS.
# PROTECTED_SCHEMA_PATHS=app/migrations/,app/alembic.ini

# the generic-webtool template's golden-path skeleton directory
# (relative to backend/). create-type builds stage from it; image assembly
# always uses its pinned Dockerfile.
# TEMPLATE_SKELETON_DIR=templates/generic-webtool

# ADR 0016: TTL preview container. Minutes a preview stays live
# before the worker sweep tears it down. Default 60.
# PREVIEW_TTL_MINUTES=60

# Port the previewed app listens on inside its own container (matches the
# generic-webtool template's compose.yaml). Default 8000.
# PREVIEW_CONTAINER_PORT=8000

# HMAC key signing preview access tokens (signed,
# expiring preview URL). Unset or BLANK in dev: a random per-process key is
# generated at startup (fine — tokens are short-lived). PROD REQUIRES IT, at
# least 32 bytes (ProdSigningSecretError at startup):
# a restart must not invalidate live preview links, and the API
# and the worker must agree. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# DEV CAVEAT: the WORKER issues a preview token and the API server VERIFIES it,
# so with this unset each process generates its own key and the platform-origin
# preview link answers 403 ("invalid preview token signature") in dev. Set the
# same value here to use previews with a dev worker.
# PREVIEW_SIGNING_SECRET=

# which failing checks push a build
# into the "medium" vs "high" tier (a flagged check not listed in either set
# is treated as high-tier — fail closed on tier mapping too, never silently
# "low"). Comma-separated check names, operator-tunable without a code
# change. The defaults add
# `destructive_ddl` (the sixth check, ADR 0023 §Schema migrations) to the
# medium default below — if you already override POLICY_MEDIUM_TIER_CHECKS
# in your own .env, `destructive_ddl` resolves to "high" (fail-closed, not
# listed in either tier) until you add it here yourself.
# POLICY_MEDIUM_TIER_CHECKS=dependency_vulnerabilities,resource_limits,template_compliance,destructive_ddl
# POLICY_HIGH_TIER_CHECKS=secrets_pii,egress_detection

# required human-approval
# count for medium/high tier (low always auto-approves regardless of these).
# Default 1 each; raising high to 2-person approval (ADR 0008) is just
# bumping this value.
# POLICY_MEDIUM_APPROVALS_REQUIRED=1
# POLICY_HIGH_APPROVALS_REQUIRED=1

# health-gated switchover
# window (seconds) — GET /healthz must return 200 within this time or the
# deployment fails with HEALTH_TIMEOUT. Default 30.
# DEPLOY_HEALTH_CHECK_TIMEOUT_SECONDS=30.0

# Prefix for the per-deployment, default-deny Docker network an L4 service
# container attaches to. Traefik label generation / prod routing are handled separately —
# dev mode reuses the platform-proxy (docker exec) mechanism.
# DEPLOY_NETWORK_NAME=forge-deploy-net

# prod-shape Traefik routing (Docker-label
# based; L2 never calls a Traefik API). Default if unset: off in dev, on in
# prod. With this off, dev-mode platform-proxy behavior is
# byte-for-byte unchanged regardless of the other TRAEFIK_* settings below.
# TRAEFIK_ENABLED=false

# Base domain for stable per-project hostnames: a deployed service is routed
# at {project_id}.{apps_base_domain}; previews at
# preview--{project_id}.{apps_base_domain}. Operator config.
# APPS_BASE_DOMAIN=apps.forge.local

# Name of the operator-provisioned Traefik container. The platform connects
# this container into each deployed/preview service's own private network
# once that service is eligible for traffic (after the health gate / at
# preview start) — per-service networks keep services isolated from each
# other while Traefik can reach each of them. Provisioning Traefik itself
# (and TLS/ACME) is an operator concern, out of scope here
# (ADR 0002). Run Traefik with its Docker provider enabled, e.g.:
#   docker run -d --name forge-traefik -p 80:80 \
#     --add-host=host.docker.internal:host-gateway \
#     -v /var/run/docker.sock:/var/run/docker.sock:ro \
#     traefik:v3.6 --providers.docker=true \
#     --providers.docker.exposedbydefault=false --entrypoints.web.address=:80 \
#     --entrypoints.forgemetrics.address=127.0.0.1:8082 --metrics.prometheus=true \
#     --metrics.prometheus.entryPoint=forgemetrics
# NOTE: use traefik v3.6.1+ — older v3.x pins Docker API 1.24, which recent
# Docker Engines reject (traefik/traefik#12253).
# TRAEFIK_CONTAINER_NAME=forge-traefik

# the port of Traefik's loopback-only metrics entrypoint (the
# `forgemetrics` entrypoint in the docker run example above, 127.0.0.1:8082).
# When set (and Traefik routes), the worker reads Traefik's request counters every
# 60 s through `docker exec` into TRAEFIK_CONTAINER_NAME, nothing is published,
# and a deployed service's traffic counts as activity. Without it a live service
# under Traefik is never treated as idle by the zombie sweep. The entrypoint MUST
# bind 127.0.0.1: if the port also listens on any other address of the container
# the worker refuses the signal and logs an error. After the signal is first
# enabled, live services stay exempt for one full
# PROJECT_LIFECYCLE_IDLE_THRESHOLD_DAYS. No effect while TRAEFIK_ENABLED is false.
# TRAEFIK_METRICS_PORT=8082

# Address (host:port) where the Traefik container can reach the platform's
# preview forward-auth verification endpoint (routers/preview_auth.py).
# Default assumes the platform API runs as a host process, reached by the
# name host.docker.internal. Docker Desktop provides that name; a plain Linux
# engine does not, so start Traefik with
#   --add-host=host.docker.internal:host-gateway
# (without it ForwardAuth cannot resolve the address and previews answer 500).
# Point this at the API container's address instead if the platform itself is
# containerized.
# TRAEFIK_FORWARD_AUTH_HOST=host.docker.internal:8000

# entrypoint, cert resolver, and URL scheme are operator
# configuration, exactly like OIDC_ISSUER — this platform does not choose
# between an internal CA, self-signed certs, or plaintext intranet HTTP.
# DEFAULT INSTALL IS PLAINTEXT: with all three left unset/default below, the
# signed preview token (the preview's sole credential, ADR 0016) travels in
# the clear. That is a disclosed property of the default install, not an
# accident. The platform session cookie does NOT: in prod it is
# Secure and __Host- prefixed, so a browser never sends it over plain http,
# and prod refuses to start without an https PLATFORM_PUBLIC_URL (below).
#
# The entrypoint name every router label is written onto. Change this once
# you have configured a second, TLS-terminating entrypoint on your own
# Traefik (conventionally named "websecure").
# TRAEFIK_ENTRYPOINT=web
#
# Certificate resolver name already configured on your own Traefik (e.g. an
# ACME resolver). Leave UNSET to keep today's behaviour: unset means the
# router labels omit BOTH the `tls` and `tls.certresolver` labels entirely,
# not `tls=false` — TLS only turns on once this is set, for both the
# service router and the preview router.
# TRAEFIK_CERT_RESOLVER=

# Scheme used to build the service base URL and the preview URL. Setting this
# to "https" is only meaningful once TRAEFIK_CERT_RESOLVER (or an
# operator-managed TLS entrypoint) actually terminates TLS at
# TRAEFIK_ENTRYPOINT above — this setting alone does not configure TLS.
# It does NOT change the forward-auth hop (next entry).
# SERVICE_URL_SCHEME=http

# scheme of Traefik's forward-auth call to the
# platform API at TRAEFIK_FORWARD_AUTH_HOST. Independent of SERVICE_URL_SCHEME:
# that hop is Traefik container -> host API on the Docker bridge, and the API
# serves plain http there. "http" or "https"; set "https" only if the API
# itself terminates TLS at that address.
# TRAEFIK_FORWARD_AUTH_SCHEME=http

# the platform's own public origin, as
# scheme://host[:port] with NO path, query or fragment (a trailing slash is a
# path). FORGE_ENV=prod: REQUIRED and must be https:// — startup aborts
# otherwise, naming this setting (blank counts as unset). Prod session and
# login cookies are Secure and __Host- prefixed, so a platform not served over
# TLS could never log anyone in. In prod, an unset OIDC_REDIRECT_URL is derived
# from this origin (never from the request). Dev: optional, any scheme.
# PLATFORM_PUBLIC_URL=https://forge.example.com
#
# Turning TLS on is ONE CHECKLIST, not two: if the platform sits behind a
# TLS-terminating proxy, also set OIDC_REDIRECT_URL (below) in the same
# pass — the request's own scheme/host is the internal one, not the
# registered callback URL.

# ADR 0018, ADR 0022
# Authentication mode: which identity mechanism
# the platform resolves behind deps.get_current_user.
#   dev   — X-Forge-User-Id header against seeded users (local dev + tests)
#   local — email + password stored on the platform's own User row, with
#           admin-approved signup (see the BOOTSTRAP_ADMIN_* block below)
#   oidc  — OIDC SSO session cookie
# Default if unset: dev=dev, prod=oidc — `local` is never a default, always
# set explicitly. FORGE_ENV=prod together with AUTH_MODE=dev is REFUSED at
# startup and there is no override flag.
# AUTH_MODE=dev

# ADR 0018 §1: the IdP is configuration, not code — endpoints are discovered
# from {OIDC_ISSUER}/.well-known/openid-configuration, so any compliant
# provider (Google Workspace, Entra ID, Okta, Keycloak) works by setting
# these three. All three are REQUIRED when AUTH_MODE=oidc; startup fails if
# one is missing (never at first login). The client secret lives only here —
# the code exchange is server-side and the browser never sees a token.
# OIDC_ISSUER=https://accounts.example.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=

# Scopes requested at login. `openid` is mandatory; `email` and `profile`
# supply the claims user provisioning needs.
# OIDC_SCOPES=openid email profile

# Absolute URL of the callback endpoint (/api/auth/callback), as registered
# with the IdP. Unset by default: in dev, derived from the incoming request,
# which is correct for a directly-served backend; in prod, derived from
# PLATFORM_PUBLIC_URL + /api/auth/callback, never from the request. Set it
# explicitly to register a different URL with the IdP.
# OIDC_REDIRECT_URL=https://forge.example.com/api/auth/callback

# idle expiry slides on activity;
# the absolute cap forces re-authentication regardless of activity.
# SESSION_IDLE_TIMEOUT_HOURS=8
# SESSION_ABSOLUTE_MAX_DAYS=7

# HMAC key signing the stateless session cookie (no session table).
# Unset or BLANK in dev -> a random
# per-process key (a restart just forces re-login); a blank line here is read
# as unset, never as an empty key (it used to be kept as "" and anyone could
# then mint a session for any user id). PROD REQUIRES IT, at least 32 bytes
# (ProdSigningSecretError at startup). Use a
# DIFFERENT value than PREVIEW_SIGNING_SECRET — these sign unrelated
# credentials. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# SESSION_SIGNING_SECRET=

# Fernet key encrypting Project.service_env_json
# at rest (a service's DB password, plus its app secret
# key) -- protects a database copy that leaves the host (a backup, a
# dump, an ad-hoc SELECT), NOT host/control-plane compromise (ADR 0002
# already made the host the trust boundary). Unset or blank in dev ->
# generated per process, same precedent as PREVIEW_SIGNING_SECRET/
# SESSION_SIGNING_SECRET above. Prod REFUSES TO START if this is unset or blank
# (ProdServiceEnvEncryptionKeyError, no override flag), as it does for those
# two, and for a stronger reason: a signing secret that changes only logs
# people out, but a key that changes on restart makes every already-stored
# value PERMANENTLY unreadable, so this has to fail at startup rather than at
# the next deploy. Use a DIFFERENT value than SESSION_SIGNING_SECRET/
# PREVIEW_SIGNING_SECRET -- one leak must not hand over more than one
# primitive. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# SERVICE_ENV_ENCRYPTION_KEY=

# accepted for DECRYPTION ONLY,
# never written to. Changing SERVICE_ENV_ENCRYPTION_KEY:
#   1. set this to the PREVIOUS key;
#   2. set SERVICE_ENV_ENCRYPTION_KEY to the new one (restart);
#   3. RUN the re-encrypt command, from backend/, with the same environment the
#      platform runs with:   python -m app.reencrypt_service_env
#. It is idempotent: it rewrites
#      every stored service env still under the old key to the current key and
#      reports rows rewritten / already current / not decryptable under either
#      key, then how many rows are "still under the old key after this run".
#      It exits non-zero if any row could not be read, changed while it ran, or
#      is still under the old key.
#   4. drop this setting ONLY after that report shows "still under the old key"
#      at 0 (and, ideally, nothing unreadable). Dropping it earlier makes every
#      deploy of a service whose env is still under the old key fail.
# No service restart needed -- the plaintext a service sees never changes.
# A blank value is read as unset.
# SERVICE_ENV_ENCRYPTION_KEY_OLD=

# ADR 0023 §Data services, §Amendment 6 / §Amendment 10: the shared,
# operator-provisioned Postgres instance every generated service's database
# and role live on -- host, port, admin role and password, and the admin
# maintenance database, all in ONE DSN (there is no second setting holding
# the port -- ADR 0023 §Amendment 10). Unset means data-service provisioning
# is OFF: promotion to L4 refuses with PROVISION_UNCONFIGURED
# rather than deploying a service with no
# database -- the platform never falls back to a without-data shape.
#
# dev.ps1 brings this instance up itself (ADR 0023 §Amendment 8: the
# operator's reasons for standing up Postgres by hand -- durability, tuning,
# upgrade windows -- do not apply to a throwaway dev box) and, when this key
# is ABSENT, writes a complete generated DSN here published on LOOPBACK ONLY
# at port 55432, not 5432 (ADR 0023 §Amendment 10: "no published port" means
# no port on a ROUTABLE interface -- 127.0.0.1 is not one -- and a different
# port than Postgres's default so an instance already installed on the
# developer's machine never answers instead). dev.ps1 never overwrites an
# existing value. Its data lives in the named volume
# <SERVICE_POSTGRES_CONTAINER_NAME>-data (ADR 0023 §Amendment 11), so a
# removed container comes back on the same data and reuses THIS DSN's password;
# `docker volume rm` of that volume is what discards it. When the volume exists
# but this key does not, dev.ps1 stops and says so rather than invent a password.
#
# In prod, the operator stands up their own instance (a Docker container on
# THIS SAME DAEMON, addressed by container name below -- ADR 0023 §Amendment
# 6: a managed/cloud Postgres or a bare host process cannot work here,
# because the platform reaches it by `network.connect()`, which needs a
# container) with a role that is CREATEDB CREATEROLE, never SUPERUSER (ADR
# 0023 §Amendment 5), and sets this DSN to point at it.
# SERVICE_POSTGRES_ADMIN_DSN=

# ADR 0023 §Amendment 6: the shared Postgres instance's container
# NAME (not its endpoint -- that is the DSN above; same split
# TRAEFIK_CONTAINER_NAME/TRAEFIK_FORWARD_AUTH_HOST already has). The platform
# attaches this container to each deployment's network exactly as it
# attaches Traefik (deploy_manager.py's connect_to_traefik pattern) -- it
# never creates or removes this container itself; the operator runs it (or
# dev.ps1 does, in dev only). dev.ps1 derives the data volume's name from it
# (<name>-data), so a renamed container gets its own volume.
# SERVICE_POSTGRES_CONTAINER_NAME=forge-service-postgres

# ADR 0023 §Amendment 8: the image dev.ps1 runs the dev
# service-Postgres from. Pinned, like every other image setting in this
# file -- never a floating tag chosen implicitly.
# SERVICE_POSTGRES_IMAGE=postgres:18-alpine

# ADR 0023 §Redis: the image the platform runs each project's OWN
# Redis container from (services/service_data.py). Unlike the shared
# Postgres, the platform owns this container's whole lifecycle in every
# mode, not only dev (ADR 0023 §Amendment 8: a cache costs nothing to
# recreate).
# SERVICE_REDIS_IMAGE=redis:8-alpine

# ADR 0023 §Amendment 10 "Sizing, and where the number lives": the
# two inputs the dev service-Postgres's max_connections is computed from,
# and the number a PROD operator is told to size their OWN instance's
# max_connections against (the admin console's read-only configuration view
# shows both). Defaults size for a 100-service
# platform at 5 connections each (SQLAlchemy's default pool size) plus a
# fixed headroom for the platform's own admin connections and live previews.
# SERVICE_DATA_EXPECTED_SERVICES=100
# SERVICE_DATA_CONNECTIONS_PER_SERVICE=5

# ADR 0023 §Backup, §Amendment 9: scheduled Postgres dumps of every
# service database, with retention -- Postgres only (Redis is a cache by
# default, `--save ""`; backing it up would imply a durability guarantee the
# platform does not make). Working defaults, all operator-tunable.
# SERVICE_DATA_BACKUP_ENABLED=true
# SERVICE_DATA_BACKUP_INTERVAL_HOURS=24
# SERVICE_DATA_BACKUP_RETENTION_DAYS=7
#
# ADR 0023 §Amendment 4: where dumps are written -- one subdirectory per
# project underneath this, resolved CWD-relative like TEMPLATE_SKELETON_DIR
# above. Not committable: the directory gets its own `.gitignore` (`*`) the
# first time a backup runs, and the repository's own .gitignore has a
# `backups/` entry -- a dump is a complete plaintext copy of a service's
# data. The platform does NOT copy dumps anywhere else (no scp, no object
# storage) -- an operator wanting off-host durability points this at a mount
# their existing backup infrastructure already covers. On a default install
# dumps therefore sit unencrypted beside the database they came from: useful
# against corruption and a bad migration, not against losing the host.
# Separately, back up SERVICE_ENV_ENCRYPTION_KEY itself (see that setting,
# above) -- a lost key with no backup makes every stored service env
# unrecoverable, which is a service-data incident, not an
# inconvenience, and this backup mechanism does not cover it (encrypted
# columns live in the platform's OWN database, not a service database).
# SERVICE_DATA_BACKUP_DIR=backups/service-data

# zombie path: the automatic sweep that flags an idle project, stops its
# active deployment, and archives it -- never deletes anything (that stage
# stays an explicit operator action). Working defaults, all
# operator-tunable.
# PROJECT_LIFECYCLE_ZOMBIE_SCAN_ENABLED=true
#
# "Default three months",
# rendered here as a literal day count.
# PROJECT_LIFECYCLE_IDLE_THRESHOLD_DAYS=90
#
# How often the sweep actually re-runs its query (an in-process deadline,
# not a durable one -- a worker restart re-scans immediately, which is
# acceptable): an already-archived project can never be re-archived, so
# this exists only to stop a repeatedly-failing stop from being retried
# every worker tick.
# PROJECT_LIFECYCLE_ZOMBIE_SCAN_INTERVAL_HOURS=1

# ADR 0023 §Amendment 2: how
# often the orphaned-preview-store sweep re-runs its enumeration of `pv_`
# databases/roles and `preview-redis` containers -- an in-process deadline
# like PROJECT_LIFECYCLE_ZOMBIE_SCAN_INTERVAL_HOURS above (a dropped `pv_`
# store simply stops being enumerated, so an early re-sweep after a worker
# restart is free and never double-reclaims).
# PREVIEW_ORPHAN_SWEEP_INTERVAL_HOURS=1

# ADR 0037: how often (seconds) the worker's label-driven reconciler runs
# after its start-up pass. It compares the Docker containers and networks that carry
# THIS installation's `forge.instance` label with the database and removes what no
# longer belongs: a sandbox, LLM proxy (it holds the real API key) or build network
# whose build is not RUNNING, a deployment container or network whose deployment is
# not ACTIVE or in progress, a preview that is no longer live. It also starts or
# recreates the Redis of every project with an ACTIVE deployment (it never removes
# one). It never touches an unlabelled object, another installation's, a volume or
# the shared Postgres. Each pass is two filtered Docker list calls and a few reads
# when nothing has drifted, so a short interval is cheap. Must be greater than 0.
# RECONCILE_INTERVAL_SECONDS=60

# ADR 0018 §5: comma-separated emails granted the `admin` role **only when
# their User row is first created** — never on a later login, so an admin who
# deliberately demotes someone listed here is not silently overridden. Empty
# by default; this is how the first admin exists at all.
#
# ADR 0022 §4: in
# AUTH_MODE=local this same setting is REUSED (not a second setting) and
# MUST hold exactly one entry — zero or several fails at startup, never at
# first login. Nobody can log in before this row exists, so it is created
# at startup (seed), not on first login. Applied only when the row is first
# CREATED — editing this value later never resets an existing admin's
# password or re-grants a role someone deliberately changed; rotating the
# bootstrap password after creation is an in-app action instead.
# BOOTSTRAP_ADMIN_EMAILS=

# ADR 0022 §4-5:
# the bootstrap admin's password in AUTH_MODE=local. REQUIRED whenever
# AUTH_MODE=local (startup fails otherwise) — there is no login event to
# hang JIT password creation off in this mode. Same row-creation-only rule
# as BOOTSTRAP_ADMIN_EMAILS above: editing this later does NOT change an
# already-created admin's password.
#
# FORGE_ENV=prod together with AUTH_MODE=local additionally REFUSES TO
# START when this is unset, equals the example value below ("admin"), or is
# shorter than 12 characters — there is NO override flag, matching the
# ADR 0018 §6 precedent. The values below are development-only, documented
# 2026-08-26 as the platform owner's chosen dev credentials — commented out
# here so a copied-and-run example never silently creates an admin account:
#   AUTH_MODE=local
#   BOOTSTRAP_ADMIN_EMAILS=admin@admin.com
#   BOOTSTRAP_ADMIN_PASSWORD=admin
# BOOTSTRAP_ADMIN_PASSWORD=

# ADR 0022 §10: local-mode
# login attempt limiting — the first mechanism on this platform with a
# guessable secret. Counted per account, consecutive failures only; a
# success resets the counter. A locked account's response is identical to a
# wrong-password response (spec: the lock itself must never be
# distinguishable). Defaults: 5 failures locks the account for 15 minutes.
# LOCAL_LOGIN_MAX_ATTEMPTS=5
# LOCAL_LOGIN_LOCKOUT_MINUTES=15

# the global monthly cost
# limit (USD) for every project and every user that has no per-subject
# override. Exceeding it WARNS and never blocks a build — per
# subject overrides are the nullable `monthly_quota_usd` columns on
# users/projects, set by an admin via PATCH /api/usage/quotas/... (a NULL
# override means "use this default", never unlimited). 100.0 is a placeholder
# chosen before any usage data existed; revisit once a month of real spend is
# visible, and treat an early breach as evidence the number is wrong.
# Unrelated to BUILD_COST_BUDGET_USD above, which is per-build enforcement.
# QUOTA_MONTHLY_USD_DEFAULT=100.0

# the IANA time zone monthly
# rollup boundaries are evaluated in, so "this month" is the same window for
# every user regardless of location. Not the server's local time and not the
# requester's. An unresolvable name aborts startup (PlatformTimezoneError).
# PLATFORM_TIMEZONE=UTC

# the unauthenticated readiness endpoint
# (GET /api/ready) answers 200 or 503 within this many seconds, even when the
# database hangs (503 naming `database`). It names only `database` and/or `worker`.
# READINESS_TIMEOUT_SECONDS=3.0

# how often (seconds) the worker measures free disk
# space on the Docker data root (from `docker info`), the platform's data
# directories (the SQLite database directory, LOCAL_GIT_ROOT) and the backup
# directory, and the two thresholds each is judged against. A path is below
# threshold when its free space is under EITHER the percentage or the absolute
# GB; 0 switches that half off. A path that cannot be measured (for example a
# Docker data root inside Docker Desktop's VM) is shown as unknown, never as OK.
# The admin console's health panel shows the result.
# HOST_DISK_CHECK_INTERVAL_SECONDS=300
# HOST_DISK_MIN_FREE_PERCENT=10
# HOST_DISK_MIN_FREE_GB=5

# how often (seconds) the worker checks every ACTIVE
# service, from a thread of its own so a slow sweep never delays it. A check asks
# whether the container exists and is running, whether its restart count went up
# since the last check, and whether /healthz answers through `docker exec` (the
# deploy health gate's path; it adds nothing to Traefik's counters and is not
# user activity). A service is unhealthy after FAILURE_THRESHOLD consecutive
# failed checks and healthy again after one pass. EXEC_TIMEOUT bounds one
# service's check (a hung Docker call reads as a /healthz timeout); CYCLE_TIMEOUT
# bounds the whole pass (services not reached keep their last result). The check
# never changes a deployment's status and never restarts anything. The admin
# console's health panel shows each service's state.
# SERVICE_CHECK_INTERVAL_SECONDS=60
# SERVICE_CHECK_FAILURE_THRESHOLD=3
# SERVICE_CHECK_EXEC_TIMEOUT_SECONDS=10
# SERVICE_CHECK_CYCLE_TIMEOUT_SECONDS=120

# operator notifications, two optional channels,
# either or both. Events: the worker went down / came back (the API process
# watches the worker's lease), a service turned unhealthy / healthy again, a disk
# fell below its threshold / recovered, and the admin console's "send test
# message". Each (kind, subject) is announced once, then again only after it
# recovered and COOLDOWN_SECONDS passed; the state is kept in the database, so a
# restart sends nothing new. A message carries the project or location name, the
# event, a timestamp and a link to the console (built from PLATFORM_PUBLIC_URL,
# so set that too) -- never a token, env value or generated content. Delivery is
# best-effort: bounded timeouts, a few retries, failures are logged and shown in
# the console, and none of them ever fails a check, build or deploy. These
# settings are read at startup; restart both processes after changing them.
#
# Webhook: an HTTPS POST of {"text": ...} (Slack incoming-webhook compatible).
# The URL is a CREDENTIAL (never printed or logged); https is required in prod;
# redirects are not followed. For a local receiver in dev: http://127.0.0.1:9099/hook
# NOTIFY_WEBHOOK_URL=
# NOTIFY_WEBHOOK_CONNECT_TIMEOUT_SECONDS=3
# NOTIFY_WEBHOOK_READ_TIMEOUT_SECONDS=5
# NOTIFY_RETRY_COUNT=2
# NOTIFY_RETRY_BACKOFF_SECONDS=2
#
# Email: SMTP, configured when NOTIFY_SMTP_HOST is set (then FROM and TO are
# required). NOTIFY_SMTP_TLS is starttls (default), ssl (implicit TLS) or none;
# none is refused in prod. USERNAME and PASSWORD go together; the password is a
# CREDENTIAL. TO is a comma-separated list of operator addresses. For a local
# sink in dev, set the host to 127.0.0.1, the port to 1025, TLS to none, and use
# forge@localhost as the sender and ops@localhost as the recipient.
# NOTIFY_SMTP_HOST=
# NOTIFY_SMTP_PORT=587
# NOTIFY_SMTP_TLS=starttls
# NOTIFY_SMTP_USERNAME=
# NOTIFY_SMTP_PASSWORD=
# NOTIFY_SMTP_FROM=
# NOTIFY_EMAIL_TO=
# NOTIFY_SMTP_TIMEOUT_SECONDS=10
#
# COOLDOWN_SECONDS: after a (kind, subject) recovered, it is announced again only
# once this long has passed since its last announcement. WORKER_CHECK_INTERVAL:
# how often the API process looks at the worker's lease. TEST_MIN_INTERVAL: the
# console's test message is refused again within this many seconds.
# NOTIFY_COOLDOWN_SECONDS=3600
# NOTIFY_WORKER_CHECK_INTERVAL_SECONDS=15
# NOTIFY_TEST_MIN_INTERVAL_SECONDS=30
